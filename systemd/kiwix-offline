#!/usr/bin/env bash
#
# Start the local offline reference server (Kiwix) and open it in the browser.
#
# Everything is served from localhost -- no internet required once the ZIM
# files have been downloaded.
#
#   kiwix-offline              open the book list in the browser
#   kiwix-offline wikipedia    open one specific book
#
set -euo pipefail

ZIM_DIR="${ZIM_DIR:-/usr/share/kiwix/zim}"
PORT="${KIWIX_PORT:-8080}"
HOST="127.0.0.1"

# Pick the book the user asked for, if any.
wanted="${1:-}"
book_path=""

if [[ -n "$wanted" ]]; then
  # Accept a full file name or a loose keyword ("wikipedia", "astronomy", ...).
  match="$(find "$ZIM_DIR" -maxdepth 1 -name '*.zim' -printf '%f\n' 2>/dev/null |
            grep -i -- "$wanted" | head -1 || true)"
  if [[ -z "$match" ]]; then
    echo "No offline book matches '$wanted'." >&2
    echo "Available:" >&2
    find "$ZIM_DIR" -maxdepth 1 -name '*.zim' -printf '  %f\n' 2>/dev/null >&2
    exit 1
  fi
  book_path="/content/$match"
fi

# Start the server once, quietly, if it is not already listening.
if ! curl -sf -o /dev/null "http://$HOST:$PORT/" 2>/dev/null; then
  if [[ ! -d "$ZIM_DIR" ]] || ! compgen -G "$ZIM_DIR/*.zim" >/dev/null; then
    echo "No offline books installed yet. Run download-offline-books.sh first." >&2
    exit 1
  fi

  if command -v systemctl >/dev/null && systemctl --user is-enabled --quiet kiwix-offline.service 2>/dev/null; then
    systemctl --user start kiwix-offline.service
  else
    nohup kiwix-serve --port "$PORT" --address "$HOST" "$ZIM_DIR" \
      >/tmp/kiwix-serve.log 2>&1 &
    disown || true
  fi

  # Wait for it to come up.
  for _ in $(seq 1 40); do
    curl -sf -o /dev/null "http://$HOST:$PORT/" 2>/dev/null && break
    sleep 0.25
  done
fi

url="http://$HOST:$PORT$book_path"

if command -v chromium >/dev/null; then
  chromium --app="$url" >/dev/null 2>&1 &
elif command -v xdg-open >/dev/null; then
  xdg-open "$url" >/dev/null 2>&1 &
else
  echo "$url"
fi
